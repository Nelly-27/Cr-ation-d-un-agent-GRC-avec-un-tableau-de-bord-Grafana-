          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(t, '1d'), risk_level AS metric, count(*) AS value FROM (SELECT coalesce(published_at, collected_at) AS t, risk_level FROM items) AS s WHERE $__timeFilter(t) GROUP BY 1, 2 ORDER BY 1"
